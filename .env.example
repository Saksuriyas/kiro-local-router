# ---- kiro-localllm configuration ----
# Copy to .env (install.sh does this for you). Real environment variables win over this file.

# Which provider tools use by default: local | openrouter | custom
DEFAULT_PROFILE=local

# Directory the tools may read/write. Empty = the directory Kiro was started in (cwd).
WORKSPACE_ROOT=

# ---- local (Ollama, native API) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Context window in tokens. Raise together with MAX_INPUT_CHARS (rule of thumb: chars ~= 3 x (num_ctx - 2000)).
OLLAMA_NUM_CTX=4096
# Set to false to ask thinking-models (qwen3, deepseek-r1) not to think. Needs a recent Ollama. Leave empty if unsure.
OLLAMA_THINK=false

# ---- openrouter (data leaves your machine!) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Safety switch: external providers are refused unless this is true.
ALLOW_EXTERNAL_PROVIDERS=false

# ---- custom (any OpenAI-compatible endpoint: LM Studio, vLLM, internal gateway) ----
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
# true = endpoint is inside your own network (skips the external-provider guard)
CUSTOM_IS_INTERNAL=false

# ---- limits ----
MAX_INPUT_CHARS=6000       # total chars of files/diff sent in one request
MAX_FILE_BYTES=1000000     # refuse to read files bigger than this
TRANSLATE_CHUNK_CHARS=6000 # translate_doc splits documents into chunks of about this size
LLM_TIMEOUT=300            # seconds
